{
  "version": 6,
  "configurePresets": [
    {
      "name": "editor",
      "displayName": "Visual Studio, game module for the Wind editor (set CMAKE_PREFIX_PATH to the SDK in CMakeUserPresets.json)",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build-editor",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "DebugGame;Release"
      }
    },
    {
      "name": "web",
      "displayName": "Emscripten WebGL2 + SDL3_mixer WAV backend (set WIND_SDK_DIR and EMSDK; configure with emcmake, or use this preset)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web",
      "toolchainFile": "$env{WIND_SDK_DIR}/source/cmake/toolchains/Emscripten.cmake",
      "cacheVariables": {
        "ENGINE_WITH_WINDOW": "ON",
        "ENGINE_WITH_WEB": "ON"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android NDK arm64-v8a (set ANDROID_NDK / ANDROID_NDK_HOME)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-android",
      "toolchainFile": "$env{WIND_SDK_DIR}/source/cmake/toolchains/android-ndk.cmake",
      "cacheVariables": {
        "ENGINE_WITH_WINDOW": "ON",
        "ENGINE_WITH_ANDROID": "ON",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-21"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "game",
      "configurePreset": "editor",
      "targets": ["electromagnetic-field"]
    },
    {
      "name": "web",
      "configurePreset": "web",
      "targets": ["electromagnetic-field"]
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64",
      "targets": ["electromagnetic-field"]
    }
  ]
}
