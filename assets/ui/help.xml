<!-- Full-screen reference. Topic bodies are separate files under help_topics/, pulled in through
     <ItemTemplate src> (the engine's only include). Only the selected topic is shown; the rest have
     display: none, so they take no space and get no clicks. Topic order matches kTopics in src/help.cpp. -->
<Canvas id="help">
    <!-- While this is open the game ignores scene mouse input itself (Game::handle_mouse), so the
         backdrop needs no hit-testable trick to keep clicks off the simulation. -->
    <Stack class="backdrop" var-display="{binding helpDisplay}">
        <Stack class="window" direction="horizontal" var-wl="{binding windowLeft}" var-ww="{binding windowWidth}">
            <Stack class="nav" direction="vertical">
                <Label class="nav-title" text="{tr help.nav_title}"/>
                <Label class="nav-sub" text="{tr help.nav_sub}"/>
                <Stack class="lang" direction="horizontal">
                    <Button class="lang" content="УК" command="{binding localeUk}" var-bg="{binding localeUkBg}"
                            var-fg="{binding localeUkFg}"/>
                    <Button class="lang" content="EN" command="{binding localeEn}" var-bg="{binding localeEnBg}"
                            var-fg="{binding localeEnFg}"/>
                </Stack>
                <ScrollView class="nav-scroll" direction="vertical" scroll-y="{binding navScroll}">
                    <!-- One row per section header or topic; the unused half is display: none. -->
                    <ItemsControl class="nav-list" items_source="{binding navItems}">
                        <ItemTemplate>
                            <Stack class="nav-row" direction="vertical">
                                <Label class="nav-header" text="{binding title}" var-display="{binding headerDisplay}"/>
                                <Button class="nav-item" content="{binding title}" command="{binding select}"
                                        var-display="{binding topicDisplay}" var-bg="{binding background}"
                                        var-fg="{binding textColor}"/>
                            </Stack>
                        </ItemTemplate>
                    </ItemsControl>
                </ScrollView>
                <Label class="nav-hint" text="{tr help.nav_hint}"/>
            </Stack>
            <Stack class="divider"/>
            <Stack class="main" direction="vertical">
                <Stack class="main-bar" direction="horizontal">
                    <Button class="close" content="{tr help.close}" command="{binding closeHelp}"/>
                </Stack>
                <ScrollView class="content" direction="vertical" scroll-y="{binding contentScroll}">
                <ItemsControl class="topic" items_source="{binding topicUsing}" var-display="{binding topicUsingDisplay}">
                    <ItemTemplate src="help_topics/howto.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicCharge}" var-display="{binding topicChargeDisplay}">
                    <ItemTemplate src="help_topics/charge.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicCoulomb}" var-display="{binding topicCoulombDisplay}">
                    <ItemTemplate src="help_topics/coulomb.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicField}" var-display="{binding topicFieldDisplay}">
                    <ItemTemplate src="help_topics/field.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicSuperposition}" var-display="{binding topicSuperpositionDisplay}">
                    <ItemTemplate src="help_topics/superposition.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicFieldLines}" var-display="{binding topicFieldLinesDisplay}">
                    <ItemTemplate src="help_topics/field_lines.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicGauss}" var-display="{binding topicGaussDisplay}">
                    <ItemTemplate src="help_topics/gauss.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicPotential}" var-display="{binding topicPotentialDisplay}">
                    <ItemTemplate src="help_topics/potential.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicPotentialEnergy}" var-display="{binding topicPotentialEnergyDisplay}">
                    <ItemTemplate src="help_topics/potential_energy.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicVoltage}" var-display="{binding topicVoltageDisplay}">
                    <ItemTemplate src="help_topics/voltage.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicGradient}" var-display="{binding topicGradientDisplay}">
                    <ItemTemplate src="help_topics/gradient.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicPairEnergy}" var-display="{binding topicPairEnergyDisplay}">
                    <ItemTemplate src="help_topics/pair_energy.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicEnergyZero}" var-display="{binding topicEnergyZeroDisplay}">
                    <ItemTemplate src="help_topics/energy_zero.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicWorkMotion}" var-display="{binding topicWorkMotionDisplay}">
                    <ItemTemplate src="help_topics/work_motion.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicConfigEnergy}" var-display="{binding topicConfigEnergyDisplay}">
                    <ItemTemplate src="help_topics/config_energy.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicGravity}" var-display="{binding topicGravityDisplay}">
                    <ItemTemplate src="help_topics/gravity.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicOverview}" var-display="{binding topicOverviewDisplay}">
                    <ItemTemplate src="help_topics/overview.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicBfield}" var-display="{binding topicBfieldDisplay}">
                    <ItemTemplate src="help_topics/bfield.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicLorentz}" var-display="{binding topicLorentzDisplay}">
                    <ItemTemplate src="help_topics/lorentz.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicCyclotron}" var-display="{binding topicCyclotronDisplay}">
                    <ItemTemplate src="help_topics/cyclotron.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicExb}" var-display="{binding topicExbDisplay}">
                    <ItemTemplate src="help_topics/exb.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicCoil}" var-display="{binding topicCoilDisplay}">
                    <ItemTemplate src="help_topics/coil.xml"/>
                </ItemsControl>
                <ItemsControl class="topic" items_source="{binding topicSimulation}" var-display="{binding topicSimulationDisplay}">
                    <ItemTemplate src="help_topics/simulation.xml"/>
                </ItemsControl>
                </ScrollView>
            </Stack>
        </Stack>
    </Stack>
</Canvas>
