<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.voltage.kicker}"/>
    <Label class="title" text="{tr help.voltage.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.voltage.p1}"/>
    <Label class="p" text="{tr help.voltage.p2}"/>
    <Label class="p" text="{tr help.voltage.p3}"/>
    <Label class="p" text="{tr help.voltage.p4}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="\Delta \varphi_{AB} = \varphi_A - \varphi_B"/>
        <Math class="display-math" display="true" formula="W_{A \to B} = q \, \Delta \varphi_{AB}"/>
        <Math class="display-math" display="true" formula="E = \frac{\Delta \varphi}{d}"/>
        <Math class="display-math" display="true" formula="1 \; \mathrm{eV} = e \cdot 1 \; \mathrm{V} \approx 1.6 \cdot 10^{-19} \; \mathrm{J}"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\Delta \varphi_{AB}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.voltage.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="W_{A \to B}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.voltage.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="d"/>
            </Stack>
            <Label class="legend-text" text="{tr help.voltage.legend3}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="E"/>
            </Stack>
            <Label class="legend-text" text="{tr help.voltage.legend4}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\mathrm{eV}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.voltage.legend5}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.voltage.q1}"/>
            <Label class="qa-a" text="{tr help.voltage.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.voltage.q2}"/>
            <Label class="qa-a" text="{tr help.voltage.a2}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.voltage.q3}"/>
            <Label class="qa-a" text="{tr help.voltage.a3}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.voltage.predict1}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer1Height}" var-gap="{binding answer1Gap}">
            <Label class="predict-a-text" text="{tr help.voltage.answer1}"/>
        </Stack>
    </Stack>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.voltage.predict2}"/>
        <Button class="reveal" content="{binding revealLabel2}" command="{binding reveal2}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer2Height}" var-gap="{binding answer2Gap}">
            <Label class="predict-a-text" text="{tr help.voltage.answer2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.voltage.p5}"/>
    <Button class="try" content="{tr help.voltage.try}" command="{binding tryIt}"/>
</Stack>
