<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.overview.kicker}"/>
    <Label class="title" text="{tr help.overview.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.overview.p1}"/>
    <Label class="p" text="{tr help.overview.p2}"/>
    <Label class="h" text="{tr help.overview.s1}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="Q \;\to\; \vec{E} \;\to\; \vec{F} = q \, \vec{E}"/>
        <Math class="display-math" display="true" formula="\vec{E} = -\nabla \varphi \;\to\; U = q \, \varphi"/>
        <Math class="display-math" display="true" formula="\Delta U = -W \;\to\; \Delta K = W \;\to\; K + U = \mathrm{const}"/>
    </Stack>
    <Label class="h" text="{tr help.overview.s2}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\vec{E}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.overview.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\varphi"/>
            </Stack>
            <Label class="legend-text" text="{tr help.overview.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\vec{F} = q \vec{E}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.overview.legend3}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="U = q \varphi"/>
            </Stack>
            <Label class="legend-text" text="{tr help.overview.legend4}"/>
        </Stack>
    </Stack>
    <Stack class="note" direction="vertical">
        <Label class="note-text" text="{tr help.overview.note}"/>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.overview.q1}"/>
            <Label class="qa-a" text="{tr help.overview.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.overview.q2}"/>
            <Label class="qa-a" text="{tr help.overview.a2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.overview.predict}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer1Height}" var-gap="{binding answer1Gap}">
            <Label class="predict-a-text" text="{tr help.overview.answer}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.overview.p3}"/>
    <Button class="try" content="{tr help.overview.try}" command="{binding tryIt}"/>
</Stack>
