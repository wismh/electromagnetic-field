<!-- Help topic: included by assets/ui/help.xml through <ItemTemplate src>. Data context is a
     HelpTopicViewModel (only binding: tryIt). Styles: assets/css/help.css. -->
<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.coulomb.kicker}"/>
    <Label class="title" text="{tr help.coulomb.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.coulomb.p1}"/>
    <Label class="p" text="{tr help.coulomb.p2}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="S = 4 \pi r^2"/>
    </Stack>
    <Label class="p" text="{tr help.coulomb.p3}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="F = k \, \frac{|q_1 \, q_2|}{r^2}"/>
        <Math class="display-math" display="true" formula="\vec{F}_{12} = k \, \frac{q_1 \, q_2}{r^2} \cdot \frac{\vec{r}_{12}}{r}"/>
        <Math class="display-math" display="true" formula="\vec{F}_{12} = -\vec{F}_{21}"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="F"/>
            </Stack>
            <Label class="legend-text" text="{tr help.coulomb.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="k"/>
            </Stack>
            <Label class="legend-text" text="{tr help.coulomb.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="q_1, \, q_2"/>
            </Stack>
            <Label class="legend-text" text="{tr help.coulomb.legend3}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="r"/>
            </Stack>
            <Label class="legend-text" text="{tr help.coulomb.legend4}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\vec{r}_{12}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.coulomb.legend5}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\vec{F}_{12}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.coulomb.legend6}"/>
        </Stack>
    </Stack>
    <Stack class="note" direction="vertical">
        <Label class="note-text" text="{tr help.coulomb.note1}"/>
        <Math class="note-math" formula="k = \frac{1}{4 \pi \varepsilon_0} \approx 8.99 \cdot 10^{9} \; \mathrm{N} \cdot \mathrm{m}^2 / \mathrm{C}^2"/>
    </Stack>
    <Stack class="note" direction="vertical">
        <Label class="note-text" text="{tr help.coulomb.note2}"/>
        <Math class="note-math" formula="F_{g} = G \, \frac{m_1 m_2}{r^2}"/>
    </Stack>
    <Stack class="note" direction="vertical">
        <Label class="note-text" text="{tr help.coulomb.note3}"/>
        <Math class="note-math" formula="F = 1 \cdot \frac{1 \cdot 1}{2^2} = 0.25"/>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.coulomb.q1}"/>
            <Label class="qa-a" text="{tr help.coulomb.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.coulomb.q2}"/>
            <Label class="qa-a" text="{tr help.coulomb.a2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.coulomb.predict1}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-display="{binding answer1Display}">
            <Label class="predict-a-text" text="{tr help.coulomb.answer1}"/>
        </Stack>
    </Stack>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.coulomb.predict2}"/>
        <Button class="reveal" content="{binding revealLabel2}" command="{binding reveal2}"/>
        <Stack class="predict-a" direction="vertical" var-display="{binding answer2Display}">
            <Label class="predict-a-text" text="{tr help.coulomb.answer2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.coulomb.p4}"/>
    <Label class="p" text="{tr help.coulomb.p5}"/>
    <Button class="try" content="{tr help.coulomb.try}" command="{binding tryIt}"/>
</Stack>
