<!-- Help topic: included by assets/ui/help.xml through <ItemTemplate src>. Data context is a
     HelpTopicViewModel (only binding: tryIt). Styles: assets/css/help.css. -->
<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.pair_energy.kicker}"/>
    <Label class="title" text="{tr help.pair_energy.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.pair_energy.p1}"/>
    <Label class="p" text="{tr help.pair_energy.p2}"/>
    <Label class="p" text="{tr help.pair_energy.p3}"/>
    <Label class="p" text="{tr help.pair_energy.p4}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="U(r) = k \, \frac{Q q}{r}"/>
        <Math class="display-math" display="true" formula="U = \sum_{i &lt; j} k \, \frac{q_i \, q_j}{r_{ij}}"/>
        <Math class="display-math" display="true" formula="\frac{m v^2}{2} = k \, \frac{Q q}{r_{\min}}"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="U(r)"/>
            </Stack>
            <Label class="legend-text" text="{tr help.pair_energy.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="Qq"/>
            </Stack>
            <Label class="legend-text" text="{tr help.pair_energy.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\sum_{i &lt; j}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.pair_energy.legend3}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="r_{ij}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.pair_energy.legend4}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="r_{\min}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.pair_energy.legend5}"/>
        </Stack>
    </Stack>
    <Stack class="note" direction="vertical">
        <Label class="note-text" text="{tr help.pair_energy.note}"/>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.pair_energy.q1}"/>
            <Label class="qa-a" text="{tr help.pair_energy.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.pair_energy.q2}"/>
            <Label class="qa-a" text="{tr help.pair_energy.a2}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.pair_energy.q3}"/>
            <Label class="qa-a" text="{tr help.pair_energy.a3}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.pair_energy.q4}"/>
            <Label class="qa-a" text="{tr help.pair_energy.a4}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.pair_energy.predict1}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-display="{binding answer1Display}">
            <Label class="predict-a-text" text="{tr help.pair_energy.answer1}"/>
        </Stack>
    </Stack>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.pair_energy.predict2}"/>
        <Button class="reveal" content="{binding revealLabel2}" command="{binding reveal2}"/>
        <Stack class="predict-a" direction="vertical" var-display="{binding answer2Display}">
            <Label class="predict-a-text" text="{tr help.pair_energy.answer2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.pair_energy.p5}"/>
    <Label class="p" text="{tr help.pair_energy.p6}"/>
    <Button class="try" content="{tr help.pair_energy.try}" command="{binding tryIt}"/>
</Stack>
