<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.work_motion.kicker}"/>
    <Label class="title" text="{tr help.work_motion.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.work_motion.p1}"/>
    <Label class="p" text="{tr help.work_motion.p2}"/>
    <Label class="p" text="{tr help.work_motion.p3}"/>
    <Label class="p" text="{tr help.work_motion.p4}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="W = \int_A^B \vec{F} \cdot d\vec{r}"/>
        <Math class="display-math" display="true" formula="\Delta K = W \qquad \Delta U = -W"/>
        <Math class="display-math" display="true" formula="K + U = \mathrm{const}"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="W"/>
            </Stack>
            <Label class="legend-text" text="{tr help.work_motion.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\vec{F} \cdot d\vec{r}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.work_motion.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\Delta K"/>
            </Stack>
            <Label class="legend-text" text="{tr help.work_motion.legend3}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\Delta U"/>
            </Stack>
            <Label class="legend-text" text="{tr help.work_motion.legend4}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.work_motion.q1}"/>
            <Label class="qa-a" text="{tr help.work_motion.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.work_motion.q2}"/>
            <Label class="qa-a" text="{tr help.work_motion.a2}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.work_motion.q3}"/>
            <Label class="qa-a" text="{tr help.work_motion.a3}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.work_motion.q4}"/>
            <Label class="qa-a" text="{tr help.work_motion.a4}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.work_motion.predict1}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer1Height}" var-gap="{binding answer1Gap}">
            <Label class="predict-a-text" text="{tr help.work_motion.answer1}"/>
        </Stack>
    </Stack>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.work_motion.predict2}"/>
        <Button class="reveal" content="{binding revealLabel2}" command="{binding reveal2}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer2Height}" var-gap="{binding answer2Gap}">
            <Label class="predict-a-text" text="{tr help.work_motion.answer2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.work_motion.p5}"/>
    <Button class="try" content="{tr help.work_motion.try}" command="{binding tryIt}"/>
</Stack>
