<!-- Help topic: included by assets/ui/help.xml through <ItemTemplate src>. Data context is a
     HelpTopicViewModel (only binding: tryIt). Styles: assets/css/help.css. -->
<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.gradient.kicker}"/>
    <Label class="title" text="{tr help.gradient.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.gradient.p1}"/>
    <Label class="p" text="{tr help.gradient.p2}"/>
    <Label class="p" text="{tr help.gradient.p3}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="\vec{E} = -\nabla \varphi"/>
        <Math class="display-math" display="true" formula="\nabla \varphi = \left( \frac{\partial \varphi}{\partial x}, \, \frac{\partial \varphi}{\partial y} \right)"/>
        <Math class="display-math" display="true" formula="E = -\frac{d \varphi}{dx} \qquad F = -\frac{dU}{dx}"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\nabla \varphi"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gradient.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\frac{\partial \varphi}{\partial x}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gradient.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="E = -\frac{d \varphi}{dx}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gradient.legend3}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="F = -\frac{dU}{dx}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gradient.legend4}"/>
        </Stack>
    </Stack>
    <Stack class="note" direction="vertical">
        <Label class="note-text" text="{tr help.gradient.note}"/>
        <Math class="note-math" formula="|E| \approx \frac{\Delta \varphi}{\Delta s}"/>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.gradient.q1}"/>
            <Label class="qa-a" text="{tr help.gradient.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.gradient.q2}"/>
            <Label class="qa-a" text="{tr help.gradient.a2}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.gradient.q3}"/>
            <Label class="qa-a" text="{tr help.gradient.a3}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.gradient.predict1}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-display="{binding answer1Display}">
            <Label class="predict-a-text" text="{tr help.gradient.answer1}"/>
        </Stack>
    </Stack>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.gradient.predict2}"/>
        <Button class="reveal" content="{binding revealLabel2}" command="{binding reveal2}"/>
        <Stack class="predict-a" direction="vertical" var-display="{binding answer2Display}">
            <Label class="predict-a-text" text="{tr help.gradient.answer2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.gradient.p4}"/>
    <Button class="try" content="{tr help.gradient.try}" command="{binding tryIt}"/>
</Stack>
