<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.charge.kicker}"/>
    <Label class="title" text="{tr help.charge.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.charge.p1}"/>
    <Label class="p" text="{tr help.charge.p2}"/>
    <Label class="p" text="{tr help.charge.p3}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="q = \pm N e"/>
        <Math class="display-math" display="true" formula="\sum_i q_i = \mathrm{const}"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="q"/>
            </Stack>
            <Label class="legend-text" text="{tr help.charge.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="e"/>
            </Stack>
            <Label class="legend-text" text="{tr help.charge.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="N"/>
            </Stack>
            <Label class="legend-text" text="{tr help.charge.legend3}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\sum_i q_i"/>
            </Stack>
            <Label class="legend-text" text="{tr help.charge.legend4}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="q_1 q_2 &gt; 0"/>
            </Stack>
            <Label class="legend-text" text="{tr help.charge.legend5}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="q_1 q_2 &lt; 0"/>
            </Stack>
            <Label class="legend-text" text="{tr help.charge.legend6}"/>
        </Stack>
    </Stack>
    <Stack class="note" direction="vertical">
        <Label class="note-text" text="{tr help.charge.note}"/>
        <Math class="note-math" formula="e \approx 1.602 \cdot 10^{-19} \; \mathrm{C}"/>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.charge.q1}"/>
            <Label class="qa-a" text="{tr help.charge.a1}"/>
            <Math class="qa-math" formula="q_p = \frac{2}{3}e + \frac{2}{3}e - \frac{1}{3}e = +e"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.charge.q2}"/>
            <Label class="qa-a" text="{tr help.charge.a2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.charge.predict}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer1Height}" var-gap="{binding answer1Gap}">
            <Label class="predict-a-text" text="{tr help.charge.answer}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.charge.p4}"/>
    <Label class="p" text="{tr help.charge.p5}"/>
    <Button class="try" content="{tr help.charge.try}" command="{binding tryIt}"/>
</Stack>
