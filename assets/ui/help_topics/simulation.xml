<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.simulation.kicker}"/>
    <Label class="title" text="{tr help.simulation.title}"/>
    <Label class="h" text="{tr help.simulation.s1}"/>
    <Label class="p" text="{tr help.simulation.p1}"/>
    <Label class="h" text="{tr help.simulation.s2}"/>
    <Label class="p" text="{tr help.simulation.p2}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="v_{n+1/2} = v_n + \frac{\Delta t}{2} \, a_n"/>
        <Math class="display-math" display="true" formula="x_{n+1} = x_n + \Delta t \, v_{n+1/2}"/>
        <Math class="display-math" display="true" formula="v_{n+1} = v_{n+1/2} + \frac{\Delta t}{2} \, a_{n+1}"/>
    </Stack>
    <Label class="p" text="{tr help.simulation.p2b}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="\theta = \frac{q}{m} B_z \, \Delta t"/>
    </Stack>
    <Label class="h" text="{tr help.simulation.s3}"/>
    <Label class="p" text="{tr help.simulation.p3}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="\vec{E} = k q \, \frac{\vec{r}}{(r^2 + \varepsilon^2)^{3/2}} \qquad \varphi = \frac{k q}{\sqrt{r^2 + \varepsilon^2}}"/>
    </Stack>
    <Label class="h" text="{tr help.simulation.s4}"/>
    <Label class="p" text="{tr help.simulation.p4}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="v'_{\mathrm{rel}} = -e \, v_{\mathrm{rel}}, \qquad e = 0.8"/>
    </Stack>
    <Label class="h" text="{tr help.simulation.s5}"/>
    <Label class="p" text="{tr help.simulation.p5}"/>
    <Label class="h" text="{tr help.simulation.s6}"/>
    <Label class="p" text="{tr help.simulation.p6}"/>
    <Label class="h" text="{tr help.simulation.s7}"/>
    <Label class="p" text="{tr help.simulation.p7}"/>
    <Label class="p" text="{tr help.simulation.p8}"/>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.simulation.q1}"/>
            <Label class="qa-a" text="{tr help.simulation.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.simulation.q2}"/>
            <Label class="qa-a" text="{tr help.simulation.a2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.simulation.predict}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer1Height}" var-gap="{binding answer1Gap}">
            <Label class="predict-a-text" text="{tr help.simulation.answer}"/>
        </Stack>
    </Stack>
    <Button class="try" content="{tr help.simulation.try}" command="{binding tryIt}"/>
</Stack>
