<!-- Help topic: included by assets/ui/help.xml through <ItemTemplate src>. Data context is a
     HelpTopicViewModel (only binding: tryIt). Styles: assets/css/help.css. -->
<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.potential.kicker}"/>
    <Label class="title" text="{tr help.potential.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.potential.p1}"/>
    <Label class="p" text="{tr help.potential.p2}"/>
    <Label class="p" text="{tr help.potential.p3}"/>
    <Label class="p" text="{tr help.potential.p4}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="W_{A \to B} = q \, (\varphi_A - \varphi_B)"/>
        <Math class="display-math" display="true" formula="\varphi = \frac{U}{q}"/>
        <Math class="display-math" display="true" formula="\varphi = k \, \frac{Q}{r} \qquad \varphi = \sum_i k \, \frac{q_i}{r_i}"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="W_{A \to B}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.potential.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\varphi_A, \, \varphi_B"/>
            </Stack>
            <Label class="legend-text" text="{tr help.potential.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\varphi"/>
            </Stack>
            <Label class="legend-text" text="{tr help.potential.legend3}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="U"/>
            </Stack>
            <Label class="legend-text" text="{tr help.potential.legend4}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="Q"/>
            </Stack>
            <Label class="legend-text" text="{tr help.potential.legend5}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\sum_i"/>
            </Stack>
            <Label class="legend-text" text="{tr help.potential.legend6}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.potential.q1}"/>
            <Label class="qa-a" text="{tr help.potential.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.potential.q2}"/>
            <Label class="qa-a" text="{tr help.potential.a2}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.potential.q3}"/>
            <Label class="qa-a" text="{tr help.potential.a3}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.potential.predict1}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-display="{binding answer1Display}">
            <Label class="predict-a-text" text="{tr help.potential.answer1}"/>
        </Stack>
    </Stack>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.potential.predict2}"/>
        <Button class="reveal" content="{binding revealLabel2}" command="{binding reveal2}"/>
        <Stack class="predict-a" direction="vertical" var-display="{binding answer2Display}">
            <Label class="predict-a-text" text="{tr help.potential.answer2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.potential.p5}"/>
    <Button class="try" content="{tr help.potential.try}" command="{binding tryIt}"/>
</Stack>
