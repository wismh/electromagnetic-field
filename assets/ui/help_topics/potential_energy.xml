<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.potential_energy.kicker}"/>
    <Label class="title" text="{tr help.potential_energy.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.potential_energy.p1}"/>
    <Label class="p" text="{tr help.potential_energy.p2}"/>
    <Label class="p" text="{tr help.potential_energy.p3}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="U = q \, \varphi"/>
        <Math class="display-math" display="true" formula="\varphi = \frac{U}{q} \quad \leftrightarrow \quad \vec{E} = \frac{\vec{F}}{q}"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\varphi"/>
            </Stack>
            <Label class="legend-text" text="{tr help.potential_energy.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="q"/>
            </Stack>
            <Label class="legend-text" text="{tr help.potential_energy.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="U"/>
            </Stack>
            <Label class="legend-text" text="{tr help.potential_energy.legend3}"/>
        </Stack>
    </Stack>
    <Stack class="note" direction="vertical">
        <Label class="note-text" text="{tr help.potential_energy.note}"/>
        <Math class="note-math" formula="\varphi = 1000\;\mathrm{V}: \quad q = 2\;\mathrm{C} \;\Rightarrow\; U = 2000\;\mathrm{J}"/>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.potential_energy.q1}"/>
            <Label class="qa-a" text="{tr help.potential_energy.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.potential_energy.q2}"/>
            <Label class="qa-a" text="{tr help.potential_energy.a2}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.potential_energy.q3}"/>
            <Label class="qa-a" text="{tr help.potential_energy.a3}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.potential_energy.q4}"/>
            <Label class="qa-a" text="{tr help.potential_energy.a4}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.potential_energy.predict1}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer1Height}" var-gap="{binding answer1Gap}">
            <Label class="predict-a-text" text="{tr help.potential_energy.answer1}"/>
        </Stack>
    </Stack>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.potential_energy.predict2}"/>
        <Button class="reveal" content="{binding revealLabel2}" command="{binding reveal2}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer2Height}" var-gap="{binding answer2Gap}">
            <Label class="predict-a-text" text="{tr help.potential_energy.answer2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.potential_energy.p4}"/>
    <Button class="try" content="{tr help.potential_energy.try}" command="{binding tryIt}"/>
</Stack>
