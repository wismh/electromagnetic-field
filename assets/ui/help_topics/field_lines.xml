<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.field_lines.kicker}"/>
    <Label class="title" text="{tr help.field_lines.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.field_lines.p1}"/>
    <Label class="p" text="{tr help.field_lines.p2}"/>
    <Label class="p" text="{tr help.field_lines.p3}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="\frac{d\vec{r}}{ds} = \frac{\vec{E}}{|\vec{E}|}"/>
        <Math class="display-math" display="true" formula="N \propto |q|"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\vec{r}(s)"/>
            </Stack>
            <Label class="legend-text" text="{tr help.field_lines.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\frac{d\vec{r}}{ds}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.field_lines.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="N"/>
            </Stack>
            <Label class="legend-text" text="{tr help.field_lines.legend3}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.field_lines.q1}"/>
            <Label class="qa-a" text="{tr help.field_lines.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.field_lines.q2}"/>
            <Label class="qa-a" text="{tr help.field_lines.a2}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.field_lines.q3}"/>
            <Label class="qa-a" text="{tr help.field_lines.a3}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.field_lines.predict}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer1Height}" var-gap="{binding answer1Gap}">
            <Label class="predict-a-text" text="{tr help.field_lines.answer}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.field_lines.p4}"/>
    <Label class="p" text="{tr help.field_lines.p5}"/>
    <Button class="try" content="{tr help.field_lines.try}" command="{binding tryIt}"/>
</Stack>
