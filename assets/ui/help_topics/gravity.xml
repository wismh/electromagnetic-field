<!-- Help topic: included by assets/ui/help.xml through <ItemTemplate src>. Data context is a
     HelpTopicViewModel (only binding: tryIt). Styles: assets/css/help.css. -->
<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.gravity.kicker}"/>
    <Label class="title" text="{tr help.gravity.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.gravity.p1}"/>
    <Label class="p" text="{tr help.gravity.p2}"/>
    <Label class="p" text="{tr help.gravity.p3}"/>
    <Label class="p" text="{tr help.gravity.p4}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="F = k \, \frac{|q_1 q_2|}{r^2} \qquad F = G \, \frac{m_1 m_2}{r^2}"/>
        <Math class="display-math" display="true" formula="U = k \, \frac{Q q}{r} \qquad U = -G \, \frac{M m}{r}"/>
        <Math class="display-math" display="true" formula="a = \frac{q}{m} E \qquad a = g"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="G"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gravity.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="m, \, M"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gravity.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="g"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gravity.legend3}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\frac{q}{m}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gravity.legend4}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.gravity.q1}"/>
            <Label class="qa-a" text="{tr help.gravity.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.gravity.q2}"/>
            <Label class="qa-a" text="{tr help.gravity.a2}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.gravity.q3}"/>
            <Label class="qa-a" text="{tr help.gravity.a3}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.gravity.predict}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-display="{binding answer1Display}">
            <Label class="predict-a-text" text="{tr help.gravity.answer}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.gravity.p5}"/>
    <Button class="try" content="{tr help.gravity.try}" command="{binding tryIt}"/>
</Stack>
