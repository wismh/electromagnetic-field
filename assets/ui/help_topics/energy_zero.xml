<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.energy_zero.kicker}"/>
    <Label class="title" text="{tr help.energy_zero.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.energy_zero.p1}"/>
    <Label class="p" text="{tr help.energy_zero.p2}"/>
    <Label class="p" text="{tr help.energy_zero.p3}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="U' = U + C"/>
        <Math class="display-math" display="true" formula="\Delta U = U_2 - U_1 = U'_2 - U'_1"/>
        <Math class="display-math" display="true" formula="E = K + U &lt; 0"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="C"/>
            </Stack>
            <Label class="legend-text" text="{tr help.energy_zero.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\Delta U"/>
            </Stack>
            <Label class="legend-text" text="{tr help.energy_zero.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="E = K + U"/>
            </Stack>
            <Label class="legend-text" text="{tr help.energy_zero.legend3}"/>
        </Stack>
    </Stack>
    <Stack class="note" direction="vertical">
        <Label class="note-text" text="{tr help.energy_zero.note}"/>
        <Math class="note-math" formula="K = -\frac{U}{2} \quad \Rightarrow \quad E = \frac{U}{2} &lt; 0"/>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.energy_zero.q1}"/>
            <Label class="qa-a" text="{tr help.energy_zero.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.energy_zero.q2}"/>
            <Label class="qa-a" text="{tr help.energy_zero.a2}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.energy_zero.q3}"/>
            <Label class="qa-a" text="{tr help.energy_zero.a3}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.energy_zero.q4}"/>
            <Label class="qa-a" text="{tr help.energy_zero.a4}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.energy_zero.predict1}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer1Height}" var-gap="{binding answer1Gap}">
            <Label class="predict-a-text" text="{tr help.energy_zero.answer1}"/>
        </Stack>
    </Stack>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.energy_zero.predict2}"/>
        <Button class="reveal" content="{binding revealLabel2}" command="{binding reveal2}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer2Height}" var-gap="{binding answer2Gap}">
            <Label class="predict-a-text" text="{tr help.energy_zero.answer2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.energy_zero.p4}"/>
    <Button class="try" content="{tr help.energy_zero.try}" command="{binding tryIt}"/>
</Stack>
