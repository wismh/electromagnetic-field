<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.config_energy.kicker}"/>
    <Label class="title" text="{tr help.config_energy.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.config_energy.p1}"/>
    <Label class="p" text="{tr help.config_energy.p2}"/>
    <Label class="p" text="{tr help.config_energy.p3}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="U = \sum_{i &lt; j} k \, \frac{q_i \, q_j}{r_{ij}} = \frac{1}{2} \sum_i q_i \, \varphi_i"/>
        <Math class="display-math" display="true" formula="u = \frac{\varepsilon_0 E^2}{2} \qquad U = \int u \, dV"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\varphi_i"/>
            </Stack>
            <Label class="legend-text" text="{tr help.config_energy.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\frac{1}{2}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.config_energy.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="u"/>
            </Stack>
            <Label class="legend-text" text="{tr help.config_energy.legend3}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\int u \, dV"/>
            </Stack>
            <Label class="legend-text" text="{tr help.config_energy.legend4}"/>
        </Stack>
    </Stack>
    <Stack class="note" direction="vertical">
        <Label class="note-text" text="{tr help.config_energy.note}"/>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.config_energy.q1}"/>
            <Label class="qa-a" text="{tr help.config_energy.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.config_energy.q2}"/>
            <Label class="qa-a" text="{tr help.config_energy.a2}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.config_energy.q3}"/>
            <Label class="qa-a" text="{tr help.config_energy.a3}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.config_energy.predict1}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer1Height}" var-gap="{binding answer1Gap}">
            <Label class="predict-a-text" text="{tr help.config_energy.answer1}"/>
        </Stack>
    </Stack>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.config_energy.predict2}"/>
        <Button class="reveal" content="{binding revealLabel2}" command="{binding reveal2}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer2Height}" var-gap="{binding answer2Gap}">
            <Label class="predict-a-text" text="{tr help.config_energy.answer2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.config_energy.p4}"/>
    <Button class="try" content="{tr help.config_energy.try}" command="{binding tryIt}"/>
</Stack>
