<!-- Help topic: included by assets/ui/help.xml through <ItemTemplate src>. Data context is a
     HelpTopicViewModel (only binding: tryIt). Styles: assets/css/help.css. -->
<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.field.kicker}"/>
    <Label class="title" text="{tr help.field.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.field.p1}"/>
    <Label class="p" text="{tr help.field.p2}"/>
    <Label class="p" text="{tr help.field.p3}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="\vec{E} = \frac{\vec{F}}{q}"/>
        <Math class="display-math" display="true" formula="E = k \, \frac{|Q|}{r^2}"/>
        <Math class="display-math" display="true" formula="\vec{F} = q \, \vec{E}"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\vec{E}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.field.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="Q"/>
            </Stack>
            <Label class="legend-text" text="{tr help.field.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="q"/>
            </Stack>
            <Label class="legend-text" text="{tr help.field.legend3}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="r"/>
            </Stack>
            <Label class="legend-text" text="{tr help.field.legend4}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\vec{F}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.field.legend5}"/>
        </Stack>
    </Stack>
    <Stack class="note" direction="vertical">
        <Label class="note-text" text="{tr help.field.note}"/>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.field.q1}"/>
            <Label class="qa-a" text="{tr help.field.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.field.q2}"/>
            <Label class="qa-a" text="{tr help.field.a2}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.field.q3}"/>
            <Label class="qa-a" text="{tr help.field.a3}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.field.q4}"/>
            <Label class="qa-a" text="{tr help.field.a4}"/>
            <Math class="qa-math" formula="\frac{F}{q} = \frac{2F}{2q} = E"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.field.q5}"/>
            <Label class="qa-a" text="{tr help.field.a5}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.field.predict1}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-display="{binding answer1Display}">
            <Label class="predict-a-text" text="{tr help.field.answer1}"/>
        </Stack>
    </Stack>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.field.predict2}"/>
        <Button class="reveal" content="{binding revealLabel2}" command="{binding reveal2}"/>
        <Stack class="predict-a" direction="vertical" var-display="{binding answer2Display}">
            <Label class="predict-a-text" text="{tr help.field.answer2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.field.p4}"/>
    <Label class="p" text="{tr help.field.p5}"/>
    <Button class="try" content="{tr help.field.try}" command="{binding tryIt}"/>
</Stack>
