<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.gauss.kicker}"/>
    <Label class="title" text="{tr help.gauss.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.gauss.p1}"/>
    <Label class="p" text="{tr help.gauss.p2}"/>
    <Label class="p" text="{tr help.gauss.p3}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="\Phi = \oint \vec{E} \cdot d\vec{A} = \frac{Q_{\mathrm{in}}}{\varepsilon_0}"/>
        <Math class="display-math" display="true" formula="E \cdot 4 \pi r^2 = \frac{Q}{\varepsilon_0} \quad \Rightarrow \quad E = \frac{1}{4 \pi \varepsilon_0} \, \frac{Q}{r^2}"/>
        <Math class="display-math" display="true" formula="E = \frac{\sigma}{\varepsilon_0}"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\Phi"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gauss.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\oint"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gauss.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="d\vec{A}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gauss.legend3}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="Q_{\mathrm{in}}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gauss.legend4}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\varepsilon_0"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gauss.legend5}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\sigma"/>
            </Stack>
            <Label class="legend-text" text="{tr help.gauss.legend6}"/>
        </Stack>
    </Stack>
    <Stack class="note" direction="vertical">
        <Label class="note-text" text="{tr help.gauss.note}"/>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.gauss.q1}"/>
            <Label class="qa-a" text="{tr help.gauss.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.gauss.q2}"/>
            <Label class="qa-a" text="{tr help.gauss.a2}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.gauss.q3}"/>
            <Label class="qa-a" text="{tr help.gauss.a3}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.gauss.predict1}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer1Height}" var-gap="{binding answer1Gap}">
            <Label class="predict-a-text" text="{tr help.gauss.answer1}"/>
        </Stack>
    </Stack>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.gauss.predict2}"/>
        <Button class="reveal" content="{binding revealLabel2}" command="{binding reveal2}"/>
        <Stack class="predict-a" direction="vertical" var-h="{binding answer2Height}" var-gap="{binding answer2Gap}">
            <Label class="predict-a-text" text="{tr help.gauss.answer2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.gauss.p4}"/>
    <Button class="try" content="{tr help.gauss.try}" command="{binding tryIt}"/>
</Stack>
