<!-- Help topic: included by assets/ui/help.xml through <ItemTemplate src>. Data context is a
     HelpTopicViewModel (only binding: tryIt). Styles: assets/css/help.css. -->
<Stack class="topic-body" direction="vertical">
    <Label class="kicker" text="{tr help.lorentz.kicker}"/>
    <Label class="title" text="{tr help.lorentz.title}"/>
    <Label class="h" text="{tr help.h.idea}"/>
    <Label class="p" text="{tr help.lorentz.p1}"/>
    <Label class="p" text="{tr help.lorentz.p2}"/>
    <Label class="h" text="{tr help.h.formulas}"/>
    <Stack class="formula" direction="vertical">
        <Math class="display-math" display="true" formula="\vec{F} = q \, (\vec{E} + \vec{v} \times \vec{B})"/>
        <Math class="display-math" display="true" formula="F_B = q \, \vec{v} \times \vec{B}"/>
    </Stack>
    <Label class="h" text="{tr help.h.legend}"/>
    <Stack class="legend" direction="vertical">
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\vec{F}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.lorentz.legend1}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\vec{E}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.lorentz.legend2}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\vec{B}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.lorentz.legend3}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="\vec{v}"/>
            </Stack>
            <Label class="legend-text" text="{tr help.lorentz.legend4}"/>
        </Stack>
        <Stack class="legend-row" direction="horizontal">
            <Stack class="sym" direction="vertical">
                <Math class="sym-math" formula="q"/>
            </Stack>
            <Label class="legend-text" text="{tr help.lorentz.legend5}"/>
        </Stack>
    </Stack>
    <Stack class="note" direction="vertical">
        <Label class="note-text" text="{tr help.lorentz.note}"/>
    </Stack>
    <Label class="h" text="{tr help.h.faq}"/>
    <Stack class="faq" direction="vertical">
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.lorentz.q1}"/>
            <Label class="qa-a" text="{tr help.lorentz.a1}"/>
        </Stack>
        <Stack class="qa" direction="vertical">
            <Label class="qa-q" text="{tr help.lorentz.q2}"/>
            <Label class="qa-a" text="{tr help.lorentz.a2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.predict}"/>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.lorentz.predict1}"/>
        <Button class="reveal" content="{binding revealLabel1}" command="{binding reveal1}"/>
        <Stack class="predict-a" direction="vertical" var-display="{binding answer1Display}">
            <Label class="predict-a-text" text="{tr help.lorentz.answer1}"/>
        </Stack>
    </Stack>
    <Stack class="predict" direction="vertical">
        <Label class="predict-q" text="{tr help.lorentz.predict2}"/>
        <Button class="reveal" content="{binding revealLabel2}" command="{binding reveal2}"/>
        <Stack class="predict-a" direction="vertical" var-display="{binding answer2Display}">
            <Label class="predict-a-text" text="{tr help.lorentz.answer2}"/>
        </Stack>
    </Stack>
    <Label class="h" text="{tr help.h.where}"/>
    <Label class="p" text="{tr help.lorentz.p3}"/>
    <Button class="try" content="{tr help.lorentz.try}" command="{binding tryIt}"/>
</Stack>
