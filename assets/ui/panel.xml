<Canvas id="hud">
    <Stack class="status" direction="vertical">
        <Label class="status-main" text="{binding statusText}" var-accent="{binding statusColor}"/>
        <Label class="status-sub" text="{binding sceneText}"/>
    </Stack>

    <Stack class="probe" direction="vertical" var-px="{binding probeLeft}" var-py="{binding probeTop}"
            var-pvis="{binding probeVisibility}">
        <Math class="probe-math" formula="{binding probeField}"/>
        <Math class="probe-math" formula="{binding probeComponents}"/>
        <Math class="probe-math" formula="{binding probePotential}"/>
        <Math class="probe-math probe-b" formula="{binding probeMagnetic}"
                var-display="{binding probeMagneticDisplay}"/>
    </Stack>

    <Label class="hint" text="{tr panel.hint}"/>

    <!-- ScrollView eats clicks on its background. -->
    <ScrollView class="panel" direction="vertical" var-panel-right="{binding panelRight}">
        <Label class="title" text="{tr panel.title}"/>
        <Stack class="lang" direction="horizontal">
            <Button class="lang" content="УК" command="{binding localeUk}" var-bg="{binding localeUkBg}"
                    var-fg="{binding localeUkFg}"/>
            <Button class="lang" content="EN" command="{binding localeEn}" var-bg="{binding localeEnBg}"
                    var-fg="{binding localeEnFg}"/>
        </Stack>
        <Button class="btn help" content="{tr panel.help}" command="{binding openHelp}"/>

        <Label class="section" text="{tr panel.section.time}"/>
        <Stack class="row" direction="horizontal">
            <Button class="btn wide" content="{binding pauseLabel}" command="{binding togglePause}"/>
            <Button class="btn" content="{tr panel.step}" command="{binding step}"/>
        </Stack>
        <Stack class="param-head" direction="horizontal">
            <Label class="param-name" text="{tr panel.time_scale}"/>
            <Label class="param-value" text="{binding timeScaleText}"/>
        </Stack>
        <Stack class="slider" drag="{binding timeFrac}">
            <Stack class="track">
                <Stack class="fill" var-fill="{binding timeFill}"/>
            </Stack>
        </Stack>

        <Label class="section" text="{tr panel.section.scenes}"/>
        <Button class="btn browse" content="{tr panel.scenes.browse}" command="{binding openScenes}"/>
        <Button class="btn clear" content="{tr panel.clear}" command="{binding clearAll}"/>

        <Label class="section" text="{tr panel.section.layers}"/>
        <Checkbox class="toggle" checked="{binding showPotential}">
            <Stack class="toggle-content" direction="horizontal">
                <Stack class="toggle-left" direction="horizontal">
                    <Stack class="box" checked="{binding showPotential}"/>
                    <Label class="toggle-label" text="{tr panel.layer.potential}"/>
                </Stack>
                <Label class="key" text="F1"/>
            </Stack>
        </Checkbox>
        <Checkbox class="toggle" checked="{binding showLines}">
            <Stack class="toggle-content" direction="horizontal">
                <Stack class="toggle-left" direction="horizontal">
                    <Stack class="box" checked="{binding showLines}"/>
                    <Label class="toggle-label" text="{tr panel.layer.lines}"/>
                </Stack>
                <Label class="key" text="F2"/>
            </Stack>
        </Checkbox>
        <Checkbox class="toggle" checked="{binding showGrid}">
            <Stack class="toggle-content" direction="horizontal">
                <Stack class="toggle-left" direction="horizontal">
                    <Stack class="box" checked="{binding showGrid}"/>
                    <Label class="toggle-label" text="{tr panel.layer.grid}"/>
                </Stack>
                <Label class="key" text="F3"/>
            </Stack>
        </Checkbox>
        <Checkbox class="toggle" checked="{binding showFlow}">
            <Stack class="toggle-content" direction="horizontal">
                <Stack class="toggle-left" direction="horizontal">
                    <Stack class="box" checked="{binding showFlow}"/>
                    <Label class="toggle-label" text="{tr panel.layer.flow}"/>
                </Stack>
                <Label class="key" text="F4"/>
            </Stack>
        </Checkbox>
        <Checkbox class="toggle" checked="{binding showProbe}">
            <Stack class="toggle-content" direction="horizontal">
                <Stack class="toggle-left" direction="horizontal">
                    <Stack class="box" checked="{binding showProbe}"/>
                    <Label class="toggle-label" text="{tr panel.layer.probe}"/>
                </Stack>
                <Label class="key" text="F5"/>
            </Stack>
        </Checkbox>
        <Checkbox class="toggle" checked="{binding showTrails}">
            <Stack class="toggle-content" direction="horizontal">
                <Stack class="toggle-left" direction="horizontal">
                    <Stack class="box" checked="{binding showTrails}"/>
                    <Label class="toggle-label" text="{tr panel.layer.trails}"/>
                </Stack>
                <Label class="key" text="F6"/>
            </Stack>
        </Checkbox>
        <Checkbox class="toggle" checked="{binding collisions}">
            <Stack class="toggle-content" direction="horizontal">
                <Stack class="toggle-left" direction="horizontal">
                    <Stack class="box" checked="{binding collisions}"/>
                    <Label class="toggle-label" text="{tr panel.layer.collisions}"/>
                </Stack>
                <Label class="key" text="K"/>
            </Stack>
        </Checkbox>

        <Label class="section" text="{tr panel.section.magnetic}"/>
        <Checkbox class="toggle" checked="{binding magnetic}">
            <Stack class="toggle-content" direction="horizontal">
                <Stack class="toggle-left" direction="horizontal">
                    <Stack class="box" checked="{binding magnetic}"/>
                    <Label class="toggle-label" text="{tr panel.magnetic.force}"/>
                </Stack>
                <Label class="key" text="M"/>
            </Stack>
        </Checkbox>
        <Checkbox class="toggle" checked="{binding showMagnetic}">
            <Stack class="toggle-content" direction="horizontal">
                <Stack class="toggle-left" direction="horizontal">
                    <Stack class="box" checked="{binding showMagnetic}"/>
                    <Label class="toggle-label" text="{tr panel.magnetic.field}"/>
                </Stack>
                <Label class="key" text="F7"/>
            </Stack>
        </Checkbox>
        <Stack class="param-head" direction="horizontal">
            <Label class="param-name" text="{tr panel.magnetic.b_ext}"/>
            <Label class="param-value" text="{binding bText}"/>
        </Stack>
        <Stack class="slider" drag="{binding bFrac}">
            <Stack class="track">
                <Stack class="fill" var-fill="{binding bFill}"/>
            </Stack>
        </Stack>
        <Stack class="param-head" direction="horizontal">
            <Label class="param-name" text="{tr panel.magnetic.light_speed}"/>
            <Label class="param-value" text="{binding cText}"/>
        </Stack>
        <Stack class="slider" drag="{binding cFrac}">
            <Stack class="track">
                <Stack class="fill" var-fill="{binding cFill}"/>
            </Stack>
        </Stack>

        <Label class="section" text="{tr panel.section.params}"/>
        <Stack class="param-head" direction="horizontal">
            <Label class="param-name" text="{tr panel.k_name}"/>
            <Label class="param-value" text="{binding kText}"/>
        </Stack>
        <Stack class="slider" drag="{binding kFrac}">
            <Stack class="track">
                <Stack class="fill" var-fill="{binding kFill}"/>
            </Stack>
        </Stack>
        <Stack class="param-head" direction="horizontal">
            <Label class="param-name" text="{tr panel.eps_name}"/>
            <Label class="param-value" text="{binding epsText}"/>
        </Stack>
        <Stack class="slider" drag="{binding epsFrac}">
            <Stack class="track">
                <Stack class="fill" var-fill="{binding epsFill}"/>
            </Stack>
        </Stack>
        <Stack class="param-head" direction="horizontal">
            <Label class="param-name" text="{tr panel.q_name}"/>
            <Label class="param-value" text="{binding newChargeText}"/>
        </Stack>
        <Stack class="slider" drag="{binding newChargeFrac}">
            <Stack class="track">
                <Stack class="fill" var-fill="{binding newChargeFill}"/>
            </Stack>
        </Stack>

        <Label class="section" text="{tr panel.section.energy}"/>
        <Stack class="stat" direction="horizontal">
            <Label class="stat-name" text="{tr panel.energy.kinetic}"/>
            <Label class="stat-value" text="{binding energyKinetic}"/>
        </Stack>
        <Stack class="stat" direction="horizontal">
            <Label class="stat-name" text="{tr panel.energy.potential}"/>
            <Label class="stat-value" text="{binding energyPotential}"/>
        </Stack>
        <Stack class="stat" direction="horizontal">
            <Label class="stat-name" text="{tr panel.energy.total}"/>
            <Label class="stat-value" text="{binding energyTotal}"/>
        </Stack>
        <Stack class="stat" direction="horizontal">
            <Label class="stat-name" text="{tr panel.charges}"/>
            <Label class="stat-value" text="{binding chargeCount}"/>
        </Stack>
        <Stack class="stat" direction="horizontal">
            <Label class="stat-name" text="{tr panel.speed_ratio}"/>
            <Label class="stat-value" text="{binding speedRatio}"/>
        </Stack>
    </ScrollView>
</Canvas>
