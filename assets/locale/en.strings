[[string]]
id = "welcome.note"
text = "Picture each charge as a charged balloon in a vacuum, not as an electron. A balloon has a size and bounces off its neighbors. A vacuum means no air drag: only the electric force changes the motion, and a soft bounce spends a little energy. An electron has no path to draw, and the Orbit scene is not an atom. The reference (H) says where the model parts from real particles."

[[string]]
id = "welcome.p1"
text = "A sandbox for electric and magnetic fields. Charges sit on the screen and move under the Coulomb and Lorentz forces, and the program draws the field, the potential and the energy. Moving charges make a magnetic field; switch the Lorentz force on (M) to let magnetic fields act on them."

[[string]]
id = "welcome.p2"
text = "Orange is positive, blue is negative. A white ring means pinned: that charge does not move. Dipole, like charges, quadrupole and the capacitor start pinned. Orbit, Rutherford and Swarm already have charges in motion. The L key over a charge pins or unpins it."

[[string]]
id = "welcome.panel_lead"
text = "The buttons on the right repeat the keys above. The sliders and the energy are only on the panel."

[[string]]
id = "welcome.pin"
text = "Pin or unpin the charge under the cursor."

[[string]]
id = "welcome.preset.capacitor"
text = "Two pinned rows, positive opposite negative, like plates of a capacitor."

[[string]]
id = "welcome.preset.dipole"
text = "A positive and a negative charge, both pinned. The field of a dipole."

[[string]]
id = "welcome.preset.like_pair"
text = "Two positive charges, pinned. Unpinned, they fly apart."

[[string]]
id = "welcome.preset.orbit"
text = "A negative charge circling a pinned positive one. A classical orbit, not an atom."

[[string]]
id = "welcome.preset.quadrupole"
text = "Four pinned charges, signs alternating around a square."

[[string]]
id = "welcome.preset.rutherford"
text = "Small positive charges fired past a pinned positive one. The trails bend."

[[string]]
id = "welcome.preset.swarm"
text = "Many free charges of both signs, released from rest. They pull together and bounce."

