id = "help.potential.q1"
text = "What does the potential at a point mean, physically?"

[[string]]
id = "help.potential.q2"
text = "Why doesn’t the work of an electrostatic field depend on the path?"

[[string]]
id = "help.potential.q3"
text = "Why does the potential fall as \\(\\ \\frac{{1}}{{r}}\\), while the field falls as \\(\\ \\frac{{1}}{{r^2}}\\)?"

